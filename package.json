{
  "name": "cyberrp-launcher",
  "version": "0.1.0",
  "private": true,
  "description": "Cyberpunk 2077 roleplay community launcher",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --pretty false",
    "typecheck:server": "tsc -p tsconfig.server.json --pretty false",
    "preview": "vite preview",
    "electron:dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "package:win": "npm run build && electron-builder --win nsis",
    "api:build": "tsc -p tsconfig.server.build.json",
    "api:start": "npm run api:build && node -e \"process.env.CYBERRP_API_AUTOSTART='1'; require('./dist-server/server/src/api/directory-api.js')\"",
    "test:postgres": "node --test --test-concurrency=1 server/tests/*.test.cjs",
    "api:migrate": "npm run api:build && node -e \"const {Pool}=require('pg'); const {runMigrations}=require('./dist-server/server/src/db/migrate.js'); const pool=new Pool({connectionString:process.env.DATABASE_URL}); runMigrations(pool).then(x=>console.log(x.length ? x.join('\\\\n') : 'No pending migrations')).finally(()=>pool.end()).catch(e=>{console.error(e);process.exitCode=1})\"",
    "api:register": "node scripts/register-server.mjs",
    "test:registration": "node --test scripts/tests/*.test.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "typescript": "~5.7.2",
    "vite": "^6.0.5",
    "wait-on": "^8.0.1",
    "@types/pg": "^8.11.10"
  },
  "build": {
    "appId": "com.cyberrp.launcher",
    "productName": "CyberRP",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
